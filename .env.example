# Copy this file to `.env` and fill in real values.
# All Vite envs MUST be prefixed VITE_ to be exposed to the client bundle.

# --- Site ---
VITE_SITE_URL=https://ramenlab.vercel.app

# --- Analytics ---
# Google Analytics 4 (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=

# Meta (Facebook + Instagram) Pixel — 15-digit numeric ID
VITE_META_PIXEL_ID=

# Google Ads (e.g. AW-1234567890) — paired with a conversion label
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONV_LABEL=

# TikTok Pixel (optional)
VITE_TIKTOK_PIXEL_ID=

# --- Shopify Storefront API ---
# Domain WITHOUT https://, e.g. ramenlab.myshopify.com
VITE_SHOPIFY_DOMAIN=
# Public Storefront API token (NOT the Admin API token)
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional — defaults to 2025-01
VITE_SHOPIFY_API_VERSION=

# --- Email capture / Newsletter (optional) ---
VITE_KLAVIYO_PUBLIC_API_KEY=
VITE_KLAVIYO_LIST_ID=
